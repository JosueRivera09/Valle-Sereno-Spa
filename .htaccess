# Deshabilitar listado de directorios
Options -Indexes

# Bloquear acceso a archivos sensibles y de configuración
<FilesMatch "^\.(env|git|htaccess)|(composer\.(json|lock)|package(-lock)?\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Proteger carpetas internas que no deben ser consultadas directamente por URL
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|config|database|storage)/ - [F,L]
</IfModule>
